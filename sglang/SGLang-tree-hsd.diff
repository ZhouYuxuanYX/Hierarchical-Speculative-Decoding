+def _validate_sampled_tree(view) -> None:
+    """Constraints of rejection sampling / HSD on a sampled EAGLE tree (topk > 1)."""
+    topk, steps = view.speculative_eagle_topk, view.speculative_num_steps
+    if view.speculative_use_block_verification and not view.speculative_use_hsd:
+        raise ValueError(
+            "--speculative-use-block-verification is chain-only; use "
+            "--speculative-use-hsd to block-verify a sampled tree."
+        )
+    full_tree = 1 + topk + (steps - 1) * topk * topk
+    # A drawn child dropped by its own score would bias the remaining draws.
+    if view.speculative_num_draft_tokens != full_tree:
+        raise ValueError(
+            "Rejection sampling / HSD on a sampled tree must not prune it: set "
+            f"--speculative-num-draft-tokens {full_tree} "
+            f"(= 1 + topk + (num_steps - 1) * topk^2), got "
+            f"{view.speculative_num_draft_tokens}."
+        )
+    # Seeded draws hash (request, position): siblings would share their noise.
+    if view.enable_deterministic_inference:
+        raise ValueError(
+            "Rejection sampling / HSD on a sampled tree does not support "
+            "--enable-deterministic-inference."
+        )
+    if view.enable_multi_layer_eagle:
+        raise ValueError(
+            "Rejection sampling / HSD on a sampled tree does not support "
+            "--enable-multi-layer-eagle."
+        )
+
