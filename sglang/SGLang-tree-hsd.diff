@@ -0,0 +1,270 @@
+"""Sampled-tree verifiers (tree HSD and RRSw) on trees built by EAGLE's own tree code."""
+
+import itertools
+import os
+
+import pytest
+import torch
+from scipy.stats import chi2
+
+from sglang.kernels.ops.speculative.reject_sampling import (
+    chain_speculative_sampling_triton,
+)
+from sglang.kernels.ops.speculative.sampled_tree_verify import sampled_tree_verify
+from sglang.srt.speculative.eagle_utils import (
+    build_tree_kernel_efficient,
+    organize_draft_results,
+)
+from sglang.srt.speculative.spec_utils import select_top_k_tokens
+from sglang.test.ci.ci_register import register_cuda_ci
+
+register_cuda_ci(est_time=120, stage="base-b-kernel-unit", runner_config="1-gpu-small")
+
+DEVICE = "cuda"
+
+
+class _Lm:
+    """Context-dependent target p and draft q over a tiny vocab, one row per prefix.
+
+    A prefix t_0..t_d (t_0 the root) has code sum_i (t_i + 1) * (V + 1)^i.
+    """
+
+    def __init__(self, vocab, max_len, seed, zero_frac=0.2):
+        g = torch.Generator().manual_seed(seed)
+        rows = (vocab + 1) ** max_len
+        conc = torch.full((vocab,), 0.6)
+        p = torch.distributions.Dirichlet(conc).sample((rows,))
+        q = 0.5 * p + 0.5 * torch.distributions.Dirichlet(conc).sample((rows,))
+        # Zeros in q: some nodes have fewer than topk real children. Zeros in p:
+        # drafts the target can never produce.
+        q[torch.rand(rows, vocab, generator=g) < zero_frac] = 0.0
+        p[torch.rand(rows, vocab, generator=g) < zero_frac / 2] = 0.0
+        q[q.sum(-1) == 0, 0] = 1.0
+        p[p.sum(-1) == 0, 0] = 1.0
+        self.p = (p / p.sum(-1, keepdim=True)).to(DEVICE)
+        self.q = (q / q.sum(-1, keepdim=True)).to(DEVICE)
+        self.vocab = vocab
+
+    def extend(self, codes, tokens, depth):
+        return codes + (tokens + 1) * (self.vocab + 1) ** depth
+
+
+def _children(q, k, sample):
+    """k children per row: draws without replacement in draw order, or the top-k."""
+    keys = q.log()
+    if sample:
+        keys = keys - torch.empty_like(q).exponential_().log()
+    idx = torch.topk(keys, k, dim=-1).indices
+    return idx, q.gather(-1, idx)
+
+
+def _draft_tree(lm, bs, topk, steps, sample=True):
+    """EAGLE's draft loop with lm as the draft head; nothing is pruned."""
+    root_codes = torch.ones(bs, dtype=torch.long, device=DEVICE)  # root token 0
+    q_root = lm.q[root_codes]
+    topk_index, topk_p = _children(q_root, topk, sample)
+    cand_codes = [lm.extend(root_codes[:, None], topk_index, 1)]
+    draft_probs = [q_root[:, None]]
+    score_list, token_list, parents_list = [], [], []
+    scores = None
+    for i in range(steps):
+        _, _, scores, tree_info = select_top_k_tokens(
+            i, topk_p, topk_index, None, scores, topk
+        )
+        score_list.append(tree_info[0])
+        token_list.append(tree_info[1])
+        parents_list.append(tree_info[2])
+        if i == 0:
+            frontier = cand_codes[0]
+        else:
+            frontier = cand_codes[i].gather(1, tree_info[2] - (topk * topk * (i - 1) + topk))
+        if i == steps - 1:
+            break
+        q = lm.q[frontier]  # [bs, topk, vocab]
+        draft_probs.append(q)
+        topk_index, topk_p = _children(q.view(bs * topk, -1), topk, sample)
+        cand_codes.append(
+            lm.extend(frontier.view(bs * topk, 1), topk_index, i + 2).view(bs, -1)
+        )
+
+    num_nodes = 1 + topk + (steps - 1) * topk * topk
+    parent_list, top_scores_index, draft_tokens = organize_draft_results(
+        score_list, token_list, parents_list, num_nodes
+    )
+    node_codes = torch.cat(
+        [root_codes[:, None], torch.cat(cand_codes, 1).gather(1, top_scores_index)], 1
+    )
+    seq_lens = torch.full((bs,), 16, dtype=torch.long, device=DEVICE)
+    _, _, retrieve_index, next_token, next_sibling, tokens = build_tree_kernel_efficient(
+        torch.zeros(bs, dtype=torch.long, device=DEVICE),
+        parent_list,
+        top_scores_index,
+        draft_tokens,
+        seq_lens,
+        int(seq_lens.sum()),
+        topk,
+        steps,
+        num_nodes,
+    )
+    return dict(
+        candidates=tokens.view(bs, num_nodes),
+        retrieve_index=retrieve_index,
+        next_token=next_token,
+        next_sibling=next_sibling,
+        target_probs=lm.p[node_codes].contiguous(),
+        draft_probs=torch.cat(draft_probs, 1).contiguous(),
+        node_codes=node_codes,
+    )
+
+
+def _verify(tree, topk, steps, use_hsd, coins=None, final_coins=None):
+    bs, num_nodes = tree["candidates"].shape
+    if coins is None:
+        coins = torch.rand(bs, num_nodes, steps + 1, device=DEVICE)
+        final_coins = torch.rand(bs, device=DEVICE)
+    predicts = torch.full((bs * num_nodes,), -1, dtype=torch.int32, device=DEVICE)
+    accept_index = torch.full((bs, steps + 1), -1, dtype=torch.int32, device=DEVICE)
+    num_accept = torch.empty(bs, dtype=torch.int32, device=DEVICE)
+    sampled_tree_verify(
+        predicts,
+        accept_index,
+        num_accept,
+        tree["candidates"],
+        tree["retrieve_index"],
+        tree["next_token"],
+        tree["next_sibling"],
+        coins,
+        final_coins,
+        tree["target_probs"],
+        tree["draft_probs"],
+        topk=topk,
+        use_hsd=use_hsd,
+    )
+    return predicts, accept_index, num_accept
+
+
+def _first_tokens(lm, tree, predicts, accept_index, num_accept, length):
+    """The first `length` tokens each step commits, continued from p where it stops."""
+    bs, num_nodes = tree["candidates"].shape
+    local = (accept_index.long() - torch.arange(bs, device=DEVICE)[:, None] * num_nodes).clamp(min=0)
+    drafted = tree["candidates"].gather(1, local)  # column j: j-th accepted node
+    bonus = predicts.long()[accept_index.long().gather(1, num_accept.long()[:, None])][:, 0]
+    out = torch.empty(bs, length, dtype=torch.long, device=DEVICE)
+    codes = torch.ones(bs, dtype=torch.long, device=DEVICE)
+    for j in range(length):
+        sampled = torch.multinomial(lm.p[codes], 1)[:, 0]
+        tok = torch.where(
+            j < num_accept,
+            drafted[:, min(j + 1, local.shape[1] - 1)],
+            torch.where(j == num_accept, bonus, sampled),
+        )
+        out[:, j] = tok
+        codes = lm.extend(codes, tok, j + 1)
+    return out
+
+
+def _exact_joint(lm, length):
+    probs = []
+    for seq in itertools.product(range(lm.vocab), repeat=length):
+        code, prob = 1, 1.0
+        for j, tok in enumerate(seq):
+            prob *= lm.p[code, tok].item()
+            code += (tok + 1) * (lm.vocab + 1) ** (j + 1)
+        probs.append(prob)
+    return torch.tensor(probs, dtype=torch.float64)
+
+
+def _chi2_pvalue(lm, topk, steps, use_hsd, sample, trials, length=3):
+    counts = torch.zeros(lm.vocab**length, dtype=torch.float64, device=DEVICE)
+    weights = lm.vocab ** torch.arange(length - 1, -1, -1, device=DEVICE)
+    bs = 8192
+    for _ in range(trials // bs):
+        tree = _draft_tree(lm, bs, topk, steps, sample=sample)
+        out = _first_tokens(lm, tree, *_verify(tree, topk, steps, use_hsd), length)
+        counts += torch.bincount((out * weights).sum(1), minlength=counts.numel())
+    expected = _exact_joint(lm, length) * counts.sum().cpu()
+    counts = counts.cpu()
+    keep = expected >= 5
+    stat = (((counts - expected) ** 2) / expected)[keep].sum().item()
+    return chi2.sf(stat, int(keep.sum()) - 1)
+
+
+@pytest.mark.parametrize("vocab,steps", [(4, 3), (1000, 5)])
+def test_chain_matches_block_verification(vocab, steps):
+    """Single-draft HSD is block verification: on a topk=1 chain the tree walker
+    must take the same decisions as the chain block-verification kernel."""
+    torch.manual_seed(0)
+    lm_rows = None if vocab > 8 else _Lm(vocab, steps + 2, seed=1)
+    bs, num_nodes = 512, steps + 1
+    if lm_rows is None:
+        target = torch.softmax(torch.randn(bs, num_nodes, vocab, device=DEVICE) * 2, -1)
+        draft = torch.softmax(torch.randn(bs, steps, vocab, device=DEVICE) * 2, -1)
+        draft = 0.5 * draft + 0.5 * target[:, :steps]
+        candidates = torch.cat(
+            [torch.zeros(bs, 1, dtype=torch.long, device=DEVICE),
+             torch.multinomial(draft.view(-1, vocab), 1).view(bs, steps)], 1)
+        offsets = torch.arange(bs, device=DEVICE)[:, None] * num_nodes
+        tree = dict(
+            candidates=candidates,
+            retrieve_index=offsets + torch.arange(num_nodes, device=DEVICE),
+            next_token=torch.cat([torch.arange(1, num_nodes, device=DEVICE),
+                                  torch.tensor([-1], device=DEVICE)]).expand(bs, -1),
+            next_sibling=torch.full((bs, num_nodes), -1, device=DEVICE),
+            target_probs=target,
+            draft_probs=draft,
+        )
+    else:
+        tree = _draft_tree(lm_rows, bs, 1, steps)
+    coins = torch.rand(bs, num_nodes, steps + 1, device=DEVICE)
+    final_coins = torch.rand(bs, device=DEVICE)
+    predicts, accept_index, num_accept = _verify(tree, 1, steps, True, coins, final_coins)
+
+    ref_predicts = torch.full_like(predicts, -1)
+    ref_accept = torch.full_like(accept_index, -1)
+    ref_num = torch.empty_like(num_accept)
+    chain_coins = torch.zeros(bs, num_nodes, device=DEVICE)
+    chain_coins[:, :steps] = coins[:, 1, 1:]  # the walker's path starts at node 1
+    chain_speculative_sampling_triton(
+        ref_predicts, ref_accept, ref_num, tree["candidates"], tree["retrieve_index"],
+        None, None, chain_coins, final_coins, tree["target_probs"],
+        tree["draft_probs"], 1.0, 1.0, True, block_verification=True,
+    )
+    torch.testing.assert_close(num_accept, ref_num)
+    torch.testing.assert_close(accept_index, ref_accept)
+    # The bonus draw may land on the other side of a CDF boundary after rounding.
+    assert (predicts != ref_predicts).float().mean().item() < 1e-3
+
+
+@pytest.mark.parametrize("use_hsd", [True, False])
+@pytest.mark.parametrize("topk,steps", [(2, 3), (3, 2)])
+def test_lossless_on_sampled_trees(use_hsd, topk, steps):
+    """The first three committed tokens follow the target joint exactly."""
+    torch.manual_seed(1)
+    lm = _Lm(4, steps + 4, seed=2)
+    assert _chi2_pvalue(lm, topk, steps, use_hsd, sample=True, trials=8192 * 40) > 1e-4
+
+
+def test_detects_bias_of_topk_trees():
+    """Power check of the harness above: verifying top-k children as if they were
+    draws from q is not lossless, and the test must see it."""
+    torch.manual_seed(1)
+    lm = _Lm(4, 7, seed=2)
+    assert _chi2_pvalue(lm, 2, 3, True, sample=False, trials=8192 * 40) < 1e-6
+
+
+def test_hsd_accepts_at_least_rrsw():
+    """Tree HSD accepts at least as many draft tokens as RRSw on the same trees."""
+    torch.manual_seed(3)
+    lm = _Lm(8, 7, seed=4, zero_frac=0.0)
+    hsd, rrsw = 0.0, 0.0
+    for _ in range(10):
+        tree = _draft_tree(lm, 8192, 2, 4)
+        hsd += _verify(tree, 2, 4, True)[2].float().mean().item()
+        rrsw += _verify(tree, 2, 4, False)[2].float().mean().item()
+    assert hsd > rrsw
+
+
+if __name__ == "__main__":
+    import sys
+
+    sys.exit(pytest.main([__file__, "-v", "-s"]))
