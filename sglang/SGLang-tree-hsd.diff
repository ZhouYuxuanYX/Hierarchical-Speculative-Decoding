diff --git a/python/sglang/kernels/ops/speculative/sampled_tree_verify.py b/python/sglang/kernels/ops/speculative/sampled_tree_verify.py
new file mode 100644
index 0000000000..79b3c36e11
--- /dev/null
+++ b/python/sglang/kernels/ops/speculative/sampled_tree_verify.py
@@ -0,0 +1,387 @@
+"""Lossless verifiers for sampled draft trees: tree HSD and RRSw.
+
+The draft tree must be sampled: every expanded node draws its ``topk`` children from
+its draft distribution q without replacement, the children are linked through
+``retrive_next_sibling`` in draw order, and no drawn node is pruned. Node ``n``'s
+children were drawn from ``draft_probs[(retrive_next_token[n] - 1) // topk]``, which
+holds as long as children of one node occupy one aligned ``topk`` block of the
+flattened draft list, as in EAGLE's tree.
+
+Both verifiers walk the tree from the root, keeping the current node ``u``, the
+target-side distribution ``R`` at ``u`` and the proposal ``q_u`` with the tried
+children removed. From child ``c`` of ``u`` they take the path ``c``, first child of
+``c``, ... (RRSw: ``c`` alone) and block-verify it (Sun et al., 2024, Algorithm 2),
+with ``R`` / ``q_u`` at its first position:
+
+- the whole path with probability rho_g;
+- otherwise a backward scan stops at position j with probability
+  h_j = S_j / (S_j + 1 - rho_j), S_j = sum_v (rho_j p_j(v) - q_j(v))_+;
+- a stop at j >= 1 keeps the path's first j nodes and goes on at node j - 1 with
+  ``R = norm((rho_j p_j - q_j)_+)``, its first child tried; a stop at 0 replaces
+  ``R`` with ``norm((R - q_u)_+)`` and tries the next child of ``u``.
+
+The bonus token is drawn from ``R`` when the walk runs out of children. With paths
+of one node this is token-level recursive rejection sampling without replacement
+(RRSw); with first-child paths it is HSD Algorithm 3 on the tree
+(https://arxiv.org/abs/2601.05724).
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _copy_row(dst, src, VOCAB_SIZE: tl.constexpr, BLOCK_V: tl.constexpr):
+    total = 0.0
+    for v_start in range(0, VOCAB_SIZE, BLOCK_V):
+        offs = v_start + tl.arange(0, BLOCK_V)
+        mask = offs < VOCAB_SIZE
+        val = tl.load(src + offs, mask=mask, other=0.0)
+        tl.store(dst + offs, val, mask=mask)
+        total += tl.sum(val)
+    tl.debug_barrier()
+    return total
+
+
+@triton.jit
+def _residual_mass(
+    p_row, q_row, rho, q_scale, VOCAB_SIZE: tl.constexpr, BLOCK_V: tl.constexpr
+):
+    """sum_v (rho * p(v) - q_scale * q(v))_+."""
+    total = 0.0
+    for v_start in range(0, VOCAB_SIZE, BLOCK_V):
+        offs = v_start + tl.arange(0, BLOCK_V)
+        mask = offs < VOCAB_SIZE
+        p = tl.load(p_row + offs, mask=mask, other=0.0)
+        q = tl.load(q_row + offs, mask=mask, other=0.0)
+        total += tl.sum(tl.maximum(rho * p - q_scale * q, 0.0))
+    return total
+
+
+@triton.jit
+def _write_residual(
+    dst,
+    p_row,
+    q_row,
+    rho,
+    q_scale,
+    inv_norm,
+    VOCAB_SIZE: tl.constexpr,
+    BLOCK_V: tl.constexpr,
+):
+    """dst = (rho * p - q_scale * q)_+ * inv_norm; dst may alias p_row."""
+    for v_start in range(0, VOCAB_SIZE, BLOCK_V):
+        offs = v_start + tl.arange(0, BLOCK_V)
+        mask = offs < VOCAB_SIZE
+        p = tl.load(p_row + offs, mask=mask, other=0.0)
+        q = tl.load(q_row + offs, mask=mask, other=0.0)
+        val = tl.maximum(rho * p - q_scale * q, 0.0) * inv_norm
+        tl.store(dst + offs, val, mask=mask)
+    tl.debug_barrier()
+
+
+@triton.jit
+def _remove_token(prop, x):
+    """Zero prop[x] and return its old value, the same in every thread."""
+    removed = tl.load(prop + x)
+    # One thread stores; the others must have read the old value first.
+    tl.debug_barrier()
+    tl.store(prop + x, 0.0)
+    tl.debug_barrier()
+    return removed
+
+
+@triton.jit
+def _sample_row(row, coin, VOCAB_SIZE: tl.constexpr, BLOCK_V: tl.constexpr):
+    """Inverse-CDF draw from the unnormalized row."""
+    total = 0.0
+    for v_start in range(0, VOCAB_SIZE, BLOCK_V):
+        offs = v_start + tl.arange(0, BLOCK_V)
+        total += tl.sum(tl.load(row + offs, mask=offs < VOCAB_SIZE, other=0.0))
+    target_u = coin * total
+    cum_sum = 0.0
+    token = VOCAB_SIZE - 1
+    found = 0
+    for v_start in range(0, VOCAB_SIZE, BLOCK_V):
+        if found == 0:
+            offs = v_start + tl.arange(0, BLOCK_V)
+            val = tl.load(row + offs, mask=offs < VOCAB_SIZE, other=0.0)
+            above = (cum_sum + tl.cumsum(val, axis=0)) > target_u
+            if tl.max(above, axis=0):
+                token = v_start + tl.argmax(above.to(tl.int32), axis=0)
+                found = 1
+            cum_sum += tl.sum(val)
+    return token
+
+
+@triton.jit
+def sampled_tree_verify_kernel(
+    Predicts,
+    AcceptIndex,
+    AcceptTokenNum,
+    Candidates,
+    RetriveIndex,
+    RetriveNextToken,
+    RetriveNextSibling,
+    UniformSamples,
+    UniformSamplesFinal,
+    TargetProbs,
+    DraftProbs,
+    ResidualScratch,
+    ProposalScratch,
+    PathScratch,
+    RhoScratch,
+    stride_acc_b,
+    stride_uni_b,
+    stride_uni_n,
+    stride_tp_b,
+    stride_tp_n,
+    stride_dp_b,
+    stride_dp_r,
+    NUM_NODES: tl.constexpr,
+    TOPK: tl.constexpr,
+    MAX_PATH: tl.constexpr,
+    VOCAB_SIZE: tl.constexpr,
+    BLOCK_V: tl.constexpr,
+    USE_HSD: tl.constexpr,
+):
+    # Candidates, RetriveIndex/NextToken/NextSibling: int32 [bs, NUM_NODES], contiguous.
+    # TargetProbs [bs, NUM_NODES, vocab]; DraftProbs [bs, num_expanded, vocab]; unit
+    # vocab stride. UniformSamples [bs, NUM_NODES, MAX_PATH + 1]: coin j of the path
+    # that starts at node n is [n, j]; every node starts at most one path.
+    pid = tl.program_id(0).to(tl.int64)
+    cand = Candidates + pid * NUM_NODES
+    ridx = RetriveIndex + pid * NUM_NODES
+    first_child = RetriveNextToken + pid * NUM_NODES
+    next_sibling = RetriveNextSibling + pid * NUM_NODES
+    tp = TargetProbs + pid * stride_tp_b
+    dp = DraftProbs + pid * stride_dp_b
+    uni = UniformSamples + pid * stride_uni_b
+    res = ResidualScratch + pid * VOCAB_SIZE
+    prop = ProposalScratch + pid * VOCAB_SIZE
+    path = PathScratch + pid * (MAX_PATH + 1)
+    rho = RhoScratch + pid * (MAX_PATH + 1)
+
+    last_global = tl.load(ridx)
+    tl.store(AcceptIndex + pid * stride_acc_b, last_global)
+    num_accept = 0
+
+    # Walk state: R (res), q_u with tried children zeroed (prop, sum prop_mass).
+    _copy_row(res, tp, VOCAB_SIZE, BLOCK_V)
+    prop_mass = _copy_row(prop, dp, VOCAB_SIZE, BLOCK_V)
+    child = tl.load(first_child)
+    walking = 1
+    while walking == 1:
+        if child < 0:
+            walking = 0
+        else:
+            # The path from child down first children; it ends early where a
+            # "child" is not a real draw (q == 0: q had fewer than topk tokens).
+            # Scratch written here is read back only after the barrier below: a
+            # scalar store comes from one thread, so other threads may not see it yet.
+            g = 0
+            node = child
+            prev = child.to(tl.int64)
+            rho_val = 1.0
+            tl.store(rho, rho_val)
+            while node >= 0:
+                x = tl.load(cand + node)
+                if g == 0:
+                    p_x = tl.load(res + x)
+                    q_x = tl.load(prop + x) / prop_mass
+                else:
+                    q_row = (tl.load(first_child + prev) - 1) // TOPK
+                    p_x = tl.load(tp + prev * stride_tp_n + x)
+                    q_x = tl.load(dp + q_row.to(tl.int64) * stride_dp_r + x)
+                if q_x > 0.0:
+                    tl.store(path + g, node)
+                    rho_val = tl.minimum(rho_val * p_x / q_x, 1.0)
+                    g += 1
+                    tl.store(rho + g, rho_val)
+                    prev = node.to(tl.int64)
+                    node = tl.load(first_child + node) if USE_HSD else -1
+                    if g == MAX_PATH:
+                        node = -1
+                else:
+                    node = -1
+            tl.debug_barrier()
+
+            if g == 0:
+                walking = 0
+            else:
+                coin_row = uni + child.to(tl.int64) * stride_uni_n
+                stop = -1
+                stop_mass = 0.0
+                if tl.load(coin_row + g) < rho_val:
+                    stop = g
+                j = g - 1
+                while (stop < 0) & (j >= 1):
+                    rho_j = tl.load(rho + j)
+                    if rho_j >= 1.0:
+                        stop = j
+                    else:
+                        coin = tl.load(coin_row + j)
+                        # h_j <= rho_j, so only a coin below rho_j needs S_j.
+                        if coin < rho_j:
+                            w = tl.load(path + j - 1).to(tl.int64)
+                            q_row = (tl.load(first_child + w) - 1) // TOPK
+                            mass = _residual_mass(
+                                tp + w * stride_tp_n,
+                                dp + q_row.to(tl.int64) * stride_dp_r,
+                                rho_j,
+                                1.0,
+                                VOCAB_SIZE,
+                                BLOCK_V,
+                            )
+                            if coin * (mass + 1.0 - rho_j) < mass:
+                                stop = j
+                                stop_mass = mass
+                    j -= 1
+                if stop < 0:
+                    stop = 0
+
+                for m in range(0, stop):
+                    node = tl.load(path + m)
+                    tl.store(Predicts + last_global, tl.load(cand + node))
+                    last_global = tl.load(ridx + node)
+                    num_accept += 1
+                    tl.store(
+                        AcceptIndex + pid * stride_acc_b + num_accept, last_global
+                    )
+
+                if stop == g:
+                    # Whole path: continue at its last node, R = p after it.
+                    u = tl.load(path + g - 1).to(tl.int64)
+                    _copy_row(res, tp + u * stride_tp_n, VOCAB_SIZE, BLOCK_V)
+                    child = tl.load(first_child + u)
+                    if child >= 0:
+                        q_row = (child - 1) // TOPK
+                        prop_mass = _copy_row(
+                            prop,
+                            dp + q_row.to(tl.int64) * stride_dp_r,
+                            VOCAB_SIZE,
+                            BLOCK_V,
+                        )
+                elif stop >= 1:
+                    w = tl.load(path + stop - 1).to(tl.int64)
+                    q_row = (tl.load(first_child + w) - 1) // TOPK
+                    q_ptr = dp + q_row.to(tl.int64) * stride_dp_r
+                    rho_j = tl.load(rho + stop)
+                    if rho_j >= 1.0:  # a certain stop skipped S_j above
+                        stop_mass = _residual_mass(
+                            tp + w * stride_tp_n, q_ptr, rho_j, 1.0, VOCAB_SIZE, BLOCK_V
+                        )
+                    if stop_mass > 0.0:
+                        _write_residual(
+                            res,
+                            tp + w * stride_tp_n,
+                            q_ptr,
+                            rho_j,
+                            1.0,
+                            1.0 / stop_mass,
+                            VOCAB_SIZE,
+                            BLOCK_V,
+                        )
+                    else:
+                        _copy_row(res, tp + w * stride_tp_n, VOCAB_SIZE, BLOCK_V)
+                    stop_node = tl.load(path + stop)
+                    x_stop = tl.load(cand + stop_node)
+                    prop_mass = _copy_row(prop, q_ptr, VOCAB_SIZE, BLOCK_V)
+                    prop_mass -= _remove_token(prop, x_stop)
+                    child = tl.load(next_sibling + stop_node)
+                else:
+                    q_scale = 1.0 / prop_mass
+                    mass = _residual_mass(res, prop, 1.0, q_scale, VOCAB_SIZE, BLOCK_V)
+                    if mass > 0.0:
+                        _write_residual(
+                            res, res, prop, 1.0, q_scale, 1.0 / mass, VOCAB_SIZE, BLOCK_V
+                        )
+                    x0 = tl.load(cand + child)
+                    prop_mass -= _remove_token(prop, x0)
+                    child = tl.load(next_sibling + child)
+
+    tl.store(AcceptTokenNum + pid, num_accept)
+    coin_final = tl.load(UniformSamplesFinal + pid)
+    tl.store(Predicts + last_global, _sample_row(res, coin_final, VOCAB_SIZE, BLOCK_V))
+
+
+def sampled_tree_verify(
+    predicts: torch.Tensor,  # mutable, [bs * num_nodes]
+    accept_index: torch.Tensor,  # mutable, [bs, max_path + 1]
+    accept_token_num: torch.Tensor,  # mutable, [bs]
+    candidates: torch.Tensor,
+    retrive_index: torch.Tensor,
+    retrive_next_token: torch.Tensor,
+    retrive_next_sibling: torch.Tensor,
+    uniform_samples: torch.Tensor,
+    uniform_samples_for_final_sampling: torch.Tensor,
+    target_probs: torch.Tensor,
+    draft_probs: torch.Tensor,
+    threshold_single=None,  # unused: lossless only, like the chain sampler
+    threshold_acc=None,  # unused
+    deterministic=None,  # unused
+    *,
+    topk: int,
+    use_hsd: bool,
+) -> None:
+    """Verify sampled draft trees with tree HSD (``use_hsd``) or RRSw.
+
+    ``candidates`` / ``retrive_*``: [bs, num_nodes], node 0 is the root (the last
+    committed token). ``target_probs``: [bs, num_nodes, vocab], row n is the target
+    distribution after node n. ``draft_probs``: [bs, num_expanded, vocab], row
+    (first_child(n) - 1) // topk is the distribution node n's children were drawn
+    from. ``uniform_samples``: [bs, num_nodes, max_path + 1] with
+    max_path = accept_index.shape[1] - 1.
+    """
+    batch_size, num_nodes = candidates.shape
+    vocab_size = target_probs.shape[-1]
+    max_path = accept_index.shape[1] - 1
+    assert uniform_samples.shape == (batch_size, num_nodes, max_path + 1)
+    assert target_probs.stride(-1) == 1 and draft_probs.stride(-1) == 1
+    device = target_probs.device
+
+    def as_int32(t):
+        return t.to(torch.int32).contiguous()
+
+    residual_scratch = torch.empty(
+        (batch_size, vocab_size), dtype=torch.float32, device=device
+    )
+    proposal_scratch = torch.empty_like(residual_scratch)
+    path_scratch = torch.empty(
+        (batch_size, max_path + 1), dtype=torch.int32, device=device
+    )
+    rho_scratch = torch.empty(
+        (batch_size, max_path + 1), dtype=torch.float32, device=device
+    )
+    sampled_tree_verify_kernel[(batch_size,)](
+        predicts,
+        accept_index,
+        accept_token_num,
+        as_int32(candidates),
+        as_int32(retrive_index),
+        as_int32(retrive_next_token),
+        as_int32(retrive_next_sibling),
+        uniform_samples,
+        uniform_samples_for_final_sampling,
+        target_probs,
+        draft_probs,
+        residual_scratch,
+        proposal_scratch,
+        path_scratch,
+        rho_scratch,
+        accept_index.stride(0),
+        uniform_samples.stride(0),
+        uniform_samples.stride(1),
+        target_probs.stride(0),
+        target_probs.stride(1),
+        draft_probs.stride(0),
+        draft_probs.stride(1),
+        NUM_NODES=num_nodes,
+        TOPK=topk,
+        MAX_PATH=max_path,
+        VOCAB_SIZE=vocab_size,
+        BLOCK_V=4096 if vocab_size >= 4096 else triton.next_power_of_2(vocab_size),
+        USE_HSD=use_hsd,
+        num_warps=8,
+    )
